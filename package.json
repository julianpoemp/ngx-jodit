{
  "name": "jodit",
  "version": "0.0.0",
  "scripts": {
    "ng": "nx",
    "postinstall": "node ./decorate-angular-cli.js",
    "start": "nx serve demo",
    "start:pro": "nx serve demo-pro",
    "build": "nx build",
    "build:lib": "nx build ngx-jodit",
    "release:lib": "nx run ngx-jodit:version --releaseAs=patch --push",
    "publish:lib": "nx npm ngx-jodit",
    "build:lib:pro": "nx build ngx-jodit-pro",
    "release:lib:pro": "nx run ngx-jodit-pro:version --releaseAs=patch --push",
    "publish:lib:pro": "nx npm ngx-jodit-pro",
    "build:docs": "nx build demo && mv -f ./dist/apps/demo/* ./docs",
    "update": "nx migrate latest",
    "migrate": "npx nx migrate --run-migrations",
    "test": "nx test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.5",
    "@angular/common": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/core": "22.1.5",
    "@angular/forms": "22.1.5",
    "@angular/platform-browser": "22.1.5",
    "@angular/platform-browser-dynamic": "22.1.5",
    "@angular/router": "22.1.5",
    "@nx/angular": "23.2.0",
    "bootstrap": "^5.2.2",
    "bootstrap-icons": "^1.9.1",
    "jodit": "^4.7.9",
    "jodit-pro": "^4.7.6",
    "rxjs": "7.8.1",
    "tslib": "^2.3.0",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.7",
    "@angular/build": "22.1.7",
    "@angular-devkit/core": "22.1.7",
    "@angular-devkit/schematics": "22.1.7",
    "@angular-eslint/eslint-plugin": "22.4.0",
    "@angular-eslint/eslint-plugin-template": "22.4.0",
    "@angular-eslint/template-parser": "22.4.0",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "22.1.5",
    "@angular/language-service": "22.1.5",
    "@commitlint/cli": "^17.0.0",
    "@commitlint/config-angular": "^17.0.0",
    "@eslint/eslintrc": "^3.0.0",
    "@jscutlery/semver": "^7.1.0",
    "@nx/cypress": "23.2.0",
    "@nx/eslint": "23.2.0",
    "@nx/eslint-plugin": "23.2.0",
    "@nx/js": "23.2.0",
    "@nx/workspace": "23.2.0",
    "@schematics/angular": "22.1.7",
    "@types/node": "18.16.9",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@typescript-eslint/utils": "^8.59.2",
    "ajv": "^8.12.0",
    "angular-eslint": "^22.0.0",
    "autoprefixer": "^10.4.0",
    "cypress": "15.21.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.4.1",
    "husky": "^8.0.0",
    "ng-packagr": "22.1.1",
    "ngx-deploy-npm": "^9.0.0",
    "nx": "23.2.0",
    "postcss": "^8.4.5",
    "postcss-import": "14.1.0",
    "postcss-preset-env": "7.5.0",
    "postcss-url": "^10.1.3",
    "prettier": "^3.7.3",
    "ts-node": "10.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.58.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "overrides": {
    "babel-plugin-istanbul": "^8.0.0",
    "test-exclude": "^8.0.0",
    "axios": "^1.16.0",
    "minimatch": "^10.0.0"
  }
}
